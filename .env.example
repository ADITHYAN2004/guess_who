# Optional settings. Nothing here is required: without a .env file the game runs with
# rooms in memory on port 3000.
# To use: copy to .env, edit, then run:  node --env-file=.env server/index.js

# Port to listen on (Render sets this itself).
PORT=3000

# Turn on Redis storage (games survive restarts, several servers can share rooms).
# Local Docker Redis from docker-compose.yml:
# REDIS_URL=redis://localhost:6380

# Most games (rooms) at once; after that "Create Room" shows "Server full" (default 100).
# Render free plan: smooth up to ~50-75 games, noticeable lag around 100.
# MAX_GAMES=100

# Prefix for Redis keys, useful if several apps share one Redis.
# REDIS_PREFIX=gw:

# Idle rooms are deleted after this many seconds (default 6 hours).
# ROOM_TTL_SECONDS=21600

# Name of this server process (default: hostname:port).
# SERVER_ID=local-1
